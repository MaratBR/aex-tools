{
  "permissions": {
    "deny": [
      "Read(./.env.private)",
      "Read(**/.env.private)",
      "Edit(./.env.private)",
      "Edit(**/.env.private)",
      "Bash(*.env.private*)",
      "PowerShell(*.env.private*)",
      "Read(./session.txt)",
      "Edit(./session.txt)",
      "Bash(*session.txt*)",
      "PowerShell(*session.txt*)",
      "Read(./.env.config)",
      "Read(**/.env.config)",
      "Edit(./.env.config)",
      "Edit(**/.env.config)",
      "Bash(*.env.config*)",
      "PowerShell(*.env.config*)",
      "Read(**/credentials.json)",
      "Edit(**/credentials.json)",
      "Bash(*credentials.json*)",
      "PowerShell(*credentials.json*)"
    ]
  }
}
