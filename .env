# Shared, non-secret config. Committed, and built into the exe.
# Auth settings (AEXT_EMAIL, JIRA_EMAIL, JIRA_TOKEN) go in app settings: run configure.

JIRA_BASE_URL=https://clearmechanic.atlassian.net

AEXT_BASE_URL=https://t.aexsoft.com

# Google OAuth client aex signs in with (a "Desktop app" client: Google does not treat its secret as
# confidential). Override both in app settings (configure) to use your own.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
