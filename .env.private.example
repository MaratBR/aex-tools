# Fallback only: auth settings belong in app settings (run configure, saved to
# %APPDATA%\aex\.env.config), which override this file. Copy to .env.private (gitignored)
# to keep them next to the repo / exe instead. Values here override .env.

# Jira Cloud API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_TOKEN=

# Your Atlassian (Jira) account email
JIRA_EMAIL=

# Your AEXT email
AEXT_EMAIL=
